# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK
# Download a service account key from Firebase Console -> Project Settings -> Service Accounts
# Place it at server/firebase/serviceAccountKey.json (DO NOT COMMIT THIS FILE)
FIREBASE_PROJECT_ID=your-project-id

# Base URL used when building full image/QR URLs returned to the frontend
SERVER_BASE_URL=http://localhost:5000

# Telegram Bot (optional — only needed if you run `npm run bot`)
# Get a token from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-from-botfather

# Comma-separated numeric Telegram user IDs allowed to use the bot (you + your colleague).
# Get your own ID by messaging @userinfobot on Telegram.
ALLOWED_TELEGRAM_IDS=123456789

# For cloud hosting (Railway, Render, ...): base64-encode your serviceAccountKey.json
# and put it here instead of committing the file. Local dev still uses the file at
# server/firebase/serviceAccountKey.json.
# Generate it with:  node -e "console.log(require('fs').readFileSync('firebase/serviceAccountKey.json').toString('base64'))"
FIREBASE_SERVICE_ACCOUNT=